<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>

<AnchorPane fx:id="anchorPane" xmlns:fx="http://javafx.com/fxml" fx:controller="com.cgvsu.GuiController">
    <MenuBar>
        <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false"
                      onAction="#onOpenModelMenuItemClick"
                      text="Load Model"
                      accelerator="Ctrl+F"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#onSaveModelMenuItemClick"
                      text="Save Model"
                      accelerator="Ctrl+S"/>
        </Menu>

        <Menu mnemonicParsing="false" text="Camera Options">
            <MenuItem mnemonicParsing="false"
                      onAction="#handleCameraForward"
                      text="Forward"
                      accelerator="UP"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleCameraBackward"
                      text="Backward"
                      accelerator="DOWN"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleCameraLeft"
                      text="Left"
                      accelerator="LEFT"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleCameraRight"
                      text="Right"
                      accelerator="RIGHT"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleCameraUp"
                      text="Up"
                      accelerator="W"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleCameraDown"
                      text="Down"
                      accelerator="S"/>
        </Menu>

        <Menu mnemonicParsing="false" text="Model Options">

            <MenuItem mnemonicParsing="false"
                      onAction="#onSelectNextModel"
                      text="Next Model"
                      accelerator="Ctrl+PAGE_DOWN"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#onSelectPrevModel"
                      text="Prev Model"
                      accelerator="Ctrl+PAGE_UP"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleModelScaleUp"
                      text="Scale Up (+10%)"
                      accelerator="Ctrl+="/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleModelScaleDown"
                      text="Scale Down (-10%)"
                      accelerator="Ctrl+-"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleModelRotateLeft"
                      text="Rotate Left"
                      accelerator="Ctrl+LEFT"/>

            <MenuItem mnemonicParsing="false"
                      onAction="#handleModelRotateRight"
                      text="Rotate Right"
                      accelerator="Ctrl+RIGHT"/>

            <MenuItem mnemonicParsing="false" onAction="#handleModelTranslateForward" text="Translate Forward Z"/>
            <MenuItem mnemonicParsing="false" onAction="#handleModelTranslateBackward" text="Translate Backward Z"/>
        </Menu>

        <Menu mnemonicParsing="false" text="Edit">
            <MenuItem mnemonicParsing="false"
                      onAction="#onDeleteSelectedPolygon"
                      text="Delete Polygon"
                      accelerator="DELETE"/>
        </Menu>
    </MenuBar>

    <ListView fx:id="modelsListView"
              AnchorPane.topAnchor="30.0"
              AnchorPane.leftAnchor="0.0"
              prefWidth="220.0"
              prefHeight="200.0"/>

    <ListView fx:id="polygonsListView"
              AnchorPane.topAnchor="230.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.bottomAnchor="40.0"
              prefWidth="220.0"/>

    <Button text="Delete Polygon"
            onAction="#onDeleteSelectedPolygon"
            AnchorPane.leftAnchor="10.0"
            AnchorPane.bottomAnchor="5.0"
            prefWidth="200.0"/>

    <Canvas fx:id="canvas"
            AnchorPane.topAnchor="30.0"
            AnchorPane.leftAnchor="220.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"/>
</AnchorPane>
