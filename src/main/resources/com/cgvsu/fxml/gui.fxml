<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cgvsu.GuiController"
            prefWidth="1600.0" prefHeight="900.0"
            styleClass="app-root">

    <!-- TOP: menu -->
    <top>
        <MenuBar>
            <Menu text="Файл">
                <MenuItem text="Импорт модели..." onAction="#onOpenModelMenuItemClick" accelerator="Ctrl+O"/>
                <MenuItem text="Сохранить модель..." onAction="#onSaveModelMenuItemClick" accelerator="Ctrl+S"/>
                <SeparatorMenuItem/>
                <MenuItem text="Импорт текстуры..." onAction="#onOpenTextureMenuItemClick"/>
            </Menu>

            <Menu text="Камера">
                <MenuItem text="Добавить камеру" onAction="#onAddCameraMenuItemClick"/>
                <MenuItem text="Удалить камеру" onAction="#onRemoveCameraMenuItemClick"/>
                <MenuItem text="Пред. камера" onAction="#onPrevCameraMenuItemClick"/>
                <MenuItem text="След. камера" onAction="#onNextCameraMenuItemClick"/>
            </Menu>

            <Menu text="Модель">
                <MenuItem text="Пред. модель" onAction="#onSelectPrevModel" accelerator="Ctrl+PAGE_UP"/>
                <MenuItem text="След. модель" onAction="#onSelectNextModel" accelerator="Ctrl+PAGE_DOWN"/>
                <SeparatorMenuItem/>
                <MenuItem text="Scale +10%" onAction="#handleModelScaleUp"/>
                <MenuItem text="Scale -10%" onAction="#handleModelScaleDown"/>
                <MenuItem text="Rotate Left" onAction="#handleModelRotateLeft"/>
                <MenuItem text="Rotate Right" onAction="#handleModelRotateRight"/>
            </Menu>

            <Menu text="Правка">
                <MenuItem text="Удалить полигон" onAction="#onDeleteSelectedPolygon" accelerator="DELETE"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- LEFT: models & polygons -->
    <left>
        <VBox spacing="10" prefWidth="320" styleClass="side-panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <Label text="Модели" styleClass="h2"/>
            <ListView fx:id="modelsListView" prefHeight="180" styleClass="list"/>

            <HBox spacing="8">
                <Button text="Импорт"
                        onAction="#onOpenModelMenuItemClick"
                        maxWidth="1.7976931348623157E308"
                        HBox.hgrow="ALWAYS"/>
                <Button text="Сохранить"
                        onAction="#onSaveModelMenuItemClick"
                        maxWidth="1.7976931348623157E308"
                        HBox.hgrow="ALWAYS"/>
            </HBox>

            <Separator/>

            <Label text="Полигоны" styleClass="h2"/>
            <ListView fx:id="polygonsListView" VBox.vgrow="ALWAYS" styleClass="list"/>

            <Button text="Удалить выбранный полигон"
                    onAction="#onDeleteSelectedPolygon"
                    maxWidth="1.7976931348623157E308"/>
        </VBox>
    </left>

    <!-- CENTER: viewport -->
    <center>
        <StackPane fx:id="viewportPane" styleClass="viewport">
            <Canvas fx:id="canvas"/>
        </StackPane>
    </center>

    <!-- RIGHT: settings -->
    <right>
        <VBox spacing="12" prefWidth="340" styleClass="side-panel">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <TitledPane text="Рендер" expanded="true">
                <content>
                    <VBox spacing="8">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <CheckBox fx:id="cbWireframe" text="Каркас (wireframe)"/>
                        <CheckBox fx:id="cbTexture" text="Текстура"/>
                        <CheckBox fx:id="cbLighting" text="Освещение"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Цвет:"/>
                            <ColorPicker fx:id="fillColorPicker"/>
                        </HBox>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="Камера" expanded="true">
                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>

                        <Label text="Позиция камеры" style="-fx-font-weight: bold;"/>

                        <GridPane hgap="8" vgap="8">
                            <Label text="Px" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Slider fx:id="camPosX" min="-200" max="200" value="0"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                            <Label fx:id="camPosXVal" text="0.0" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                            <Label text="Py" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Slider fx:id="camPosY" min="-200" max="200" value="0"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS"/>
                            <Label fx:id="camPosYVal" text="0.0" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                            <Label text="Pz" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Slider fx:id="camPosZ" min="-500" max="500" value="100"
                                    GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.hgrow="ALWAYS"/>
                            <Label fx:id="camPosZVal" text="100.0" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        </GridPane>

                        <Button text="Сброс позиции камеры"
                                onAction="#onResetCameraPosition"
                                maxWidth="1.7976931348623157E308"/>

                        <Label wrapText="true"
                               text="Вращение оставлено как было (мышь/ПКМ). Ползунки двигают только позицию."/>
                    </VBox>
                </content>
            </TitledPane>


        </VBox>
    </right>

</BorderPane>
